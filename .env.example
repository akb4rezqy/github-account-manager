# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/stock-manager?retryWrites=true&w=majority"

# Dashboard login credentials (choose strong private values)
ADMIN_USERNAME="admin"
# Use either ADMIN_PASSWORD for local/simple deploys or ADMIN_PASSWORD_HASH for production.
ADMIN_PASSWORD="change-this-to-a-strong-password"
# Generate hash with: node -e "require('bcryptjs').hash(process.argv[1], 12).then(console.log)" 'your-password'
ADMIN_PASSWORD_HASH=""

# Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-secret"

# Optional for local development
PORT="3000"
NODE_ENV="development"
